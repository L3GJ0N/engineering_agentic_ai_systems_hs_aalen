{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tokens: Tokenize text (local)",
            "type": "debugpy",
            "request": "launch",
            "module": "eaas_token_lab.tokenize_text",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "",
            "preLaunchTask": "uv: sync",
            "stopOnEntry": true,
            "justMyCode": true
        },
        {
            "name": "Tokens: Tokenize chat (local)",
            "type": "debugpy",
            "request": "launch",
            "module": "eaas_token_lab.tokenize_chat",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "",
            "preLaunchTask": "uv: sync",
            "stopOnEntry": true,
            "justMyCode": true
        }
    ]
}
