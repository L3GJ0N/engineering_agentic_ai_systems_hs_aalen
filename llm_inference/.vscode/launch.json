{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LLM: Inspect HTTP (offline)",
            "type": "debugpy",
            "request": "launch",
            "module": "eaas_llm_inference.inspect_http_request",
            "python": "${workspaceFolder}/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "",
            "preLaunchTask": "uv: sync",
            "stopOnEntry": true,
            "justMyCode": true
        },
        {
            "name": "LLM: NVIDIA inference (live)",
            "type": "debugpy",
